#worse
n <- 2500
categories <- c("pop", "alternative", "rock", "classical", "rap")
music_genre <- factor(sample(categories, n, prob = c(4, 1, 3, 1, 2), replace = TRUE)) # same data generation from earlier here
x1 <- (runif(n) - 1/2) * 2 # numerical predictors centered around 0
x3 <- rnorm(n, mean = 4, sd = 2)
x4 <- rbinom(n, size = 1, prob = 0.6)
x5 <- rpois(n, lambda = 3)
predictors <- data.frame(x1 = x1, x2 = music_genre, x3 = x3, x4 = x4, x5 = x5) # creating a data frame
CEF <- function(x1, x2, x3, x4, x5) {
ifelse(x2 == "pop",
1/2 + x1^4/2,
ifelse(x2 == "classical",
1 - x3,
ifelse(x2 == "rock",
1 + x1^3 + x4^4,
ifelse(x2 == "alternative",
1 + x5 + x1^2,
# last case (rap)
sin(x5)))))}
concept_shift_worse_test_data <- predictors |> mutate(y = CEF(x1, x2, x3, x4, x5) + rnorm(n, mean = 3, sd = 0.9)) # here I have changed the distribution slightly
ggplot(concept_shift_worse_test_data, aes(x1, y, colour = x2)) + geom_point(alpha = 0.4)
concept_shift_worse_data_split <- initial_split(concept_shift_worse_test_data, strata = x2)
concept_shift_worse_rf_test <- training_workflow_rf %>%
update_model(training_rf_final) %>%
last_fit(split = concept_shift_worse_data_split) %>%
collect_metrics()
concept_shift_worse_rf_test
#better
concept_shift_better_test_data <- predictors |> mutate(y = CEF(x1, x2, x3, x4, x5) + rnorm(n, sd = 0)) # removing random noise altogether
ggplot(concept_shift_better_test_data, aes(x1, y, colour = x2)) + geom_point(alpha = 0.4)
concept_shift_better_data_split <- initial_split(concept_shift_better_test_data, strata = x2)
concept_shift_better_rf_test <- training_workflow_rf %>%
update_model(training_rf_final) %>%
last_fit(split = concept_shift_better_data_split) %>%
collect_metrics()
concept_shift_better_rf_test
