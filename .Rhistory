recipe(x2 ~ .) %>%
prep()
#type 1
training_data_tree <- decision_tree(tree_depth = 6, cost_complexity = tune("C")) %>%
set_engine("rpart") %>%
set_mode("classification")
#type 2
training_data_workflow_tree <- workflow() %>%
add_recipe(training_data_recipe) %>%
add_model(training_data_tree)
#type 3
training_data_fit_tree <- tune_grid(
training_data_workflow_tree,
grid = data.frame(C = 2^(-5:0)),
training_data_cv,
metrics = metric_set(roc_auc))
#tuning parameters
training_tree_best <- training_data_fit_tree %>%
select_best()
training_tree_final <- finalize_model(training_data_tree, training_tree_best)
training_tree_final
