x_order <- order(X)
Y_sorted <- Y[x_order]
n <- length(X)
for (i in 1:(n-1)) {
print(c(mean(Y_sorted[1:i]),
mean(Y_sorted[(i+1):n])))
}
tree_split <- function(x, y, min.obs = 10) {
x_order <- order(x)
X <- x[x_order]
Y <- y[x_order]
n <- length(x)
RSSs <- numeric(length = n-1)
RSSs[1:length(RSSs)] <- Inf
for (i in min.obs:(n-min.obs)) {
Y_left <- Y[1:i]
Y_right <- Y[(i+1):n]
RSSs[i] <- sum((Y_left - mean(Y_left))^2) +
sum((Y_right - mean(Y_right))^2)
}
X[which.min(RSSs)]
}
